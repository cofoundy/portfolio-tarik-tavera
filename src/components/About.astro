---
import { siteConfig } from "../config";
---

<section id="sobre" class="py-16 md:py-24 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Mi visión del territorio -->
    <h2 class="reveal font-serif text-3xl md:text-4xl lg:text-5xl font-bold mb-8" style="color: var(--color-primary-dark)">
      Mi visión del territorio
    </h2>

    <!-- Pull quote -->
    <blockquote class="reveal stagger-1 mb-12 md:mb-16 border-l-4 pl-6 md:pl-8 py-4" style="border-color: var(--color-primary)">
      <p class="font-serif text-xl md:text-2xl lg:text-3xl italic leading-relaxed" style="color: var(--color-primary-dark)">
        "{siteConfig.quote.text}"
      </p>
      <cite class="block mt-4 text-sm font-medium not-italic" style="color: var(--color-accent)">
        — {siteConfig.quote.author}
      </cite>
    </blockquote>

    <!-- Bio -->
    <div class="reveal stagger-1 max-w-3xl">
      <p class="text-base md:text-lg text-gray-700 leading-relaxed" set:html={siteConfig.aboutMe} />
    </div>

    <!-- Skills as subtle tags -->
    <div class="reveal stagger-2 mt-10 flex flex-wrap gap-2">
      {siteConfig.skills.map(skill => (
        <span class="tag-pill inline-block px-3 py-1.5 text-xs font-medium rounded-full border" style={`border-color: var(--color-primary); color: var(--color-primary-dark); background: ${siteConfig.colors.primary}0d;`}>
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>
