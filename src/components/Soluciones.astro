---
import { siteConfig } from "../config";

const icons: Record<string, string> = {
  map: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/></svg>',
  shield: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>',
  people: '<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>',
};
---

<section id="soluciones" class="py-16 md:py-24 topo-pattern" style="background-color: var(--color-surface)">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="reveal font-serif text-3xl md:text-4xl lg:text-5xl font-bold mb-4" style="color: var(--color-primary-dark)">
      Soluciones territoriales
    </h2>

    <!-- Quote -->
    <blockquote class="reveal stagger-1 mb-12 max-w-3xl">
      <p class="text-base md:text-lg italic leading-relaxed" style="color: var(--color-accent)">
        "{siteConfig.solucionesQuote}"
      </p>
    </blockquote>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      {siteConfig.soluciones.map((sol, i) => (
        <div class={`reveal stagger-${i + 2} card-lift bg-white rounded-xl p-6 md:p-8 border border-[var(--color-primary)]/10`}>
          <div class="mb-4" style="color: var(--color-primary)" set:html={icons[sol.icon] || icons.map} />
          <h3 class="font-serif text-xl md:text-2xl font-bold mb-2" style="color: var(--color-primary-dark)">
            {sol.title}
          </h3>
          <p class="text-sm italic mb-3" style="color: var(--color-accent)">{sol.subtitle}</p>
          <p class="text-sm text-gray-600 mb-4 leading-relaxed">{sol.description}</p>
          <ul class="space-y-2">
            {sol.items.map(item => (
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full shrink-0" style="background: var(--color-accent)"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
