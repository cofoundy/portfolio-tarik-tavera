---
import { siteConfig } from "../config";
const { amazonia } = siteConfig;
---

<section id="amazonia" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="reveal font-serif text-3xl md:text-4xl lg:text-5xl font-bold mb-4" style="color: var(--color-primary-dark)">
      {amazonia.title}
    </h2>
    <p class="reveal stagger-1 text-base md:text-lg text-gray-600 mb-8 max-w-3xl">
      {amazonia.description}
    </p>

    <!-- Google Maps embed -->
    <div class="reveal stagger-2 rounded-xl overflow-hidden shadow-lg border border-[var(--color-primary)]/10 mb-8">
      <iframe
        src={amazonia.mapUrl}
        width="100%"
        height="480"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa de proyectos en la Amazonía"
        class="w-full h-[320px] md:h-[480px]"
      ></iframe>
    </div>

    <!-- Tags -->
    <div class="reveal stagger-3 flex flex-wrap gap-3">
      {amazonia.tags.map(tag => (
        <span class="tag-pill inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium text-white" style="background: var(--color-primary)">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.274 1.765 11.307 11.307 0 00.757.433l.04.021.01.006.004.002zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd"/></svg>
          {tag}
        </span>
      ))}
    </div>
  </div>
</section>
