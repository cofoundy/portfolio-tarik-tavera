---
import { siteConfig } from "../config";
const { portafolio } = siteConfig;

const iconMap: Record<string, string> = {
  scale: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z"/></svg>',
  mountain: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21l6.75-9.75L12 15l3-4.5L21 21H3z"/></svg>',
  leaf: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21c-4-4-8-7.5-8-12a8 8 0 0116 0c0 4.5-4 8-8 12z"/></svg>',
  tree: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-6m0 0l-3-3m3 3l3-3m-6-3l-3-3 3-3 3 3 3-3 3 3-3 3"/></svg>',
  people: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>',
  shield: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>',
  chart: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>',
  building: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/></svg>',
  tools: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.645 5.645a1.5 1.5 0 01-2.12 0l-.001-.001a1.5 1.5 0 010-2.12l5.645-5.645m2.121 2.121l2.121-2.121m-2.121 2.121l5.657-5.657a1.5 1.5 0 012.121 0l.707.707a1.5 1.5 0 010 2.121l-5.657 5.657"/></svg>',
};

const modalItems = portafolio.items.filter(i => i.type === "modal");
const linkItems = portafolio.items.filter(i => i.type === "link");
const statItems = portafolio.items.filter(i => i.type === "stat");
---

<section id="portafolio" class="py-16 md:py-24" style="background-color: var(--color-surface)">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="reveal font-serif text-3xl md:text-4xl lg:text-5xl font-bold mb-4" style="color: var(--color-primary-dark)">
      {portafolio.title}
    </h2>
    <p class="reveal stagger-1 text-base md:text-lg text-gray-600 mb-10 max-w-3xl">
      {portafolio.description}
    </p>

    <!-- Primary items (modals + links) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-6">
      {[...modalItems, ...linkItems].map((item, i) => {
        const isModal = item.type === "modal";
        return (
          <button
            class={`reveal stagger-${Math.min(i + 1, 6)} card-lift flex flex-col items-center justify-center gap-3 p-6 bg-white rounded-xl border border-[var(--color-primary)]/10 text-center cursor-pointer w-full`}
            data-action={isModal ? "open-modal" : "open-link"}
            data-url={item.url}
            data-label={item.label}
          >
            <div style="color: var(--color-primary)" set:html={iconMap[item.icon] || iconMap.leaf} />
            <span class="text-sm font-medium" style="color: var(--color-primary-dark)">{item.label}</span>
            {isModal && (
              <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full" style="background: var(--color-primary); color: white; opacity: 0.8">
                Ver mapa
              </span>
            )}
            {!isModal && (
              <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full border" style="border-color: var(--color-primary); color: var(--color-primary); opacity: 0.7">
                Explorar
              </span>
            )}
          </button>
        );
      })}
    </div>

    <!-- Stats items -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
      {statItems.map((item, i) => (
        <div class={`reveal stagger-${Math.min(i + 1, 6)} flex items-center gap-2 p-3 bg-white/60 rounded-lg border border-[var(--color-primary)]/5`}>
          <div class="shrink-0" style="color: var(--color-primary); opacity: 0.6" set:html={iconMap[item.icon] || iconMap.leaf} />
          <span class="text-xs font-medium text-gray-600">{item.label}</span>
        </div>
      ))}
    </div>

    <div class="reveal stagger-6 mt-8 text-center">
      <a
        href={portafolio.driveUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm font-medium link-underline"
        style="color: var(--color-accent)"
      >
        Ver portafolio completo
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Modal overlay -->
<div id="portafolio-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 backdrop-blur-sm p-4" style="display:none">
  <div class="relative w-full max-w-5xl h-[80vh] bg-white rounded-2xl overflow-hidden shadow-2xl">
    <div class="flex items-center justify-between px-5 py-3 border-b" style="background: var(--color-surface)">
      <h3 id="modal-title" class="font-serif text-lg font-bold" style="color: var(--color-primary-dark)"></h3>
      <button id="modal-close" class="p-2 rounded-full hover:bg-gray-200 transition-colors" aria-label="Cerrar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <iframe id="modal-iframe" class="w-full h-[calc(100%-52px)]" frameborder="0" allowfullscreen></iframe>
  </div>
</div>

<script>
  const modal = document.getElementById('portafolio-modal');
  const iframe = document.getElementById('modal-iframe') as HTMLIFrameElement;
  const title = document.getElementById('modal-title');

  document.querySelectorAll('[data-action="open-modal"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      const label = btn.getAttribute('data-label');
      if (iframe && url) iframe.src = url;
      if (title && label) title.textContent = label;
      if (modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    });
  });

  document.querySelectorAll('[data-action="open-link"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      if (url) window.open(url, '_blank');
    });
  });

  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  function closeModal() {
    if (modal) { modal.style.display = 'none'; document.body.style.overflow = ''; }
    if (iframe) iframe.src = '';
  }
</script>
