---
import { siteConfig } from "../config";
const firstName = siteConfig.name.split(" ")[0];
const restName = siteConfig.name.split(" ").slice(1).join(" ");
---

<section id="hero" class="pt-20 pb-16 md:pb-24 bg-[var(--color-surface-light)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
      <!-- Text column -->
      <div class="order-2 md:order-1">
        <h1 class="hero-name">
          <span class="block font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold" style="color: var(--color-primary-dark)">
            {firstName}
          </span>
          <span class="block font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light italic" style="color: var(--color-primary)">
            {restName}
          </span>
        </h1>

        <p class="hero-subtitle mt-6 text-base md:text-lg text-gray-600 leading-relaxed max-w-lg">
          {siteConfig.title}
        </p>

        <!-- Stats -->
        <div class="hero-stats mt-8 flex flex-wrap gap-6 md:gap-10">
          {siteConfig.stats.map(stat => (
            <div class="text-center">
              <div class="font-serif text-2xl md:text-3xl font-bold" style="color: var(--color-accent)">
                {stat.value}
              </div>
              <div class="text-xs text-gray-500 mt-1 max-w-[100px] leading-tight">
                {stat.label}
              </div>
            </div>
          ))}
        </div>

        <!-- Social -->
        <div class="hero-social mt-8 flex items-center gap-4">
          {siteConfig.social.linkedin && (
            <a href={siteConfig.social.linkedin} target="_blank" rel="noopener" class="w-10 h-10 rounded-full border border-[var(--color-primary)]/20 flex items-center justify-center text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-all" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
          {siteConfig.social.instagram && (
            <a href={siteConfig.social.instagram} target="_blank" rel="noopener" class="w-10 h-10 rounded-full border border-[var(--color-primary)]/20 flex items-center justify-center text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-all" aria-label="Instagram">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C16.67.014 16.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          )}
          <a href={`mailto:${siteConfig.social.email}`} class="w-10 h-10 rounded-full border border-[var(--color-primary)]/20 flex items-center justify-center text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-all" aria-label="Email">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          </a>
        </div>
      </div>

      <!-- Photo column -->
      <div class="order-1 md:order-2 relative flex justify-center">
        <!-- Green organic shape behind photo -->
        <div class="absolute -top-4 -right-4 md:-top-6 md:-right-6 w-48 h-48 md:w-64 md:h-64 rounded-full opacity-20" style="background: var(--color-primary-light)"></div>
        <div class="hero-photo relative z-10">
          <img
            src="/profile.jpg"
            alt={siteConfig.name}
            class="w-64 h-64 md:w-80 md:h-80 object-cover object-top rounded-2xl shadow-lg"
            loading="eager"
          />
        </div>
        <!-- Small accent circle (ref: Ayana yellow circle) -->
        <div class="absolute bottom-2 right-8 md:bottom-4 md:right-12 w-16 h-16 md:w-20 md:h-20 rounded-full z-20" style="background: var(--color-accent); opacity: 0.85"></div>
      </div>
    </div>
  </div>
</section>
