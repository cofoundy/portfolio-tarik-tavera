---
import { siteConfig } from "../config";
const { cta, social } = siteConfig;
const mailto = `mailto:${social.email}?subject=${encodeURIComponent(cta.emailSubject)}`;
---

<section id="contacto" class="py-16 md:py-24 topo-pattern" style="background-color: var(--color-surface)">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="reveal font-serif text-3xl md:text-4xl lg:text-5xl font-bold mb-4" style="color: var(--color-primary-dark)">
      {cta.title}
    </h2>
    <p class="reveal stagger-1 text-base md:text-lg text-gray-600 mb-8 max-w-xl mx-auto">
      {cta.description}
    </p>
    <a
      href={mailto}
      class="reveal stagger-2 btn-primary inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-white font-medium text-base"
      style="background: var(--color-accent)"
    >
      {cta.buttonText}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
    </a>
  </div>
</section>
