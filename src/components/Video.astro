---
import { siteConfig } from "../config";
const { video } = siteConfig;
---

<section id="video" class="py-16 md:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="reveal font-serif text-3xl md:text-4xl lg:text-5xl font-bold mb-8 text-center" style="color: var(--color-primary-dark)">
      {video.title}
    </h2>

    <div class="reveal stagger-1 flex justify-center">
      <div class="w-full max-w-sm md:max-w-md rounded-2xl overflow-hidden shadow-lg border border-[var(--color-primary)]/10 aspect-[9/16]">
        <iframe
          src={`https://drive.google.com/file/d/${video.driveId}/preview`}
          width="100%"
          height="100%"
          allow="autoplay"
          allowfullscreen
          class="w-full h-full"
          loading="lazy"
          title={video.title}
        ></iframe>
      </div>
    </div>
  </div>
</section>
